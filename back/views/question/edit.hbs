<h2 class="mb-4">Edição <small class="text-black-50">{{title}}</small></h2>

{{> messages}}

<form class="row g-3 needs-validation" method="POST" action="/question/update/{{id}}" novalidate>
    <input type="hidden" id="id" name="id" value="{{id}}">
    <div class="col-12">
        <div class="form-floating mb-3">
            <input type="text" class="form-control" placeholder="Título" name="name" id="name" value="{{name}}" maxlength="250" required>
            <label for="title">Título</label>
            <div class="invalid-feedback">
                Digite o título.
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating mb-3">
            <input type="text" class="form-control" placeholder="Descrição da questão" id="description"
                      name="description" value="{{description}}" maxlength="250">
            <label for="description">Descrição</label>
            <div class="invalid-feedback">
                Digite a descrição.
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating">
            <select class="form-select" id="activity_id" name="activity_id" required>
                <option selected value="">Selecione uma atividade</option>
                {{#each activities}}
                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>
            <label for="activity_id">Atividade</label>
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating">
            <select class="form-select" id="type" name="type" disabled>
                <option value="quizz" {{#ifEquals type "quizz"}}selected{{/ifEquals}}>Quizz</option>
                <option value="truefalse" {{#ifEquals type "truefalse"}}selected{{/ifEquals}}>Verdadeiro ou Falso</option>
            </select>
            <label for="type">Tipo</label>
            <div class="text-danger">
                <span class="icon-triangle-alert text-danger"></span> Não é possível alterar o tipo da questão.
            </div>
        </div>
    </div>
    {{> form-buttons isEdit=true back="/question" }}
</form>
