<h2 class="mb-4">Novo <small class="text-black-50">{{title}}</small></h2>

{{> messages}}

<form class="row g-3 needs-validation" method="POST" action="/user/store" novalidate>
    <div class="col-12">
        <div class="form-floating mb-3">
            <input type="text" class="form-control" placeholder="Nome" name="name" id="name" value="{{form.name}}" required>
            <label for="name">Nome</label>
            <div class="invalid-feedback">
                Digite o nome.
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating mb-3">
            <input type="email" class="form-control" placeholder="E-mail" name="email" id="email" value="{{form.email}}" required>
            <label for="email">E-mail</label>
            <div class="invalid-feedback">
                Digite o e-mail.
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating mb-3">
            <input type="password" class="form-control" placeholder="Senha" name="password" id="password" value="" minlength="6" required>
            <label for="password">Senha</label>
            <div class="invalid-feedback">
                Digite a senha.
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating">
            <select class="form-select" id="role" name="role" required>
                <option selected value="">Selecione o papel</option>
                <option value="student">Estudante</option>
                <option value="teacher">Professor</option>
            </select>
            <label for="role">Papel</label>
        </div>
    </div>
    {{> form-buttons back="/user" }}
</form>


