<h2 class="mb-4">Edição <small class="text-black-50">{{title}}</small></h2>

{{> messages}}

<form class="row g-3 needs-validation" method="POST" action="/user/update/{{id}}" novalidate>
    <input type="hidden" id="id" name="id" value="{{id}}">
    <div class="col-12">
        <div class="form-floating mb-3">
            <input type="text" class="form-control" placeholder="Nome" name="name" id="name" value="{{name}}" required>
            <label for="name">Nome</label>
            <div class="invalid-feedback">
                Digite o nome.
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating mb-3">
            <input type="email" class="form-control" placeholder="E-mail" name="email" id="email" value="{{email}}" required>
            <label for="email">E-mail</label>
            <div class="invalid-feedback">
                Digite o e-mail.
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating mb-3">
            <input type="password" class="form-control" placeholder="Senha" name="password" id="password" value="" minlength="6">
            <label for="password">Senha</label>
            <div class="invalid-feedback">
                Digite a senha.
            </div>
        </div>
        <small class="d-inline-flex mb-3 px-2 py-1 text-warning-emphasis bg-warning-subtle border border-warning-subtle rounded-2">Digite uma senha se quiser alterar a atual.</small>
    </div>
    <div class="col-12">
        <div class="form-floating">
            <select class="form-select" id="role" name="role">
                <option value="student" {{selected role 'student'}}>Estudante</option>
                <option value="teacher" {{selected role 'teacher'}}>Professor</option>
            </select>
            <label for="role">Papel</label>
        </div>
    </div>
    {{> form-buttons isEdit=true back="/user" }}
</form>
